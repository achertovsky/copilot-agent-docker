# Absolute path to the project that Copilot is allowed to access.
PROJECT_PATH=/absolute/path/to/your/project

# Normally your host UID/GID are detected automatically by start.sh.
# Leave these alone unless you have a reason to override them.
USER_UID=1000
USER_GID=1000

# Optional non-interactive authentication.
# Prefer interactive "copilot login" for a personal setup.
#
# COPILOT_GITHUB_TOKEN=github_pat_...
# GH_TOKEN=github_pat_...
